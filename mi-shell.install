post_install() {
  local NIRI_DIR="$HOME/.config/niri"
  local MI_KDL="$NIRI_DIR/mi-shell.kdl"

  echo ":: MI-SHELL SETUP ::"

  # 1. Create the modular KDL file
  mkdir -p "$NIRI_DIR"
  cat > "$MI_KDL" <<EOF
# --- MI-SHELL STARTUP ---
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
spawn-at-startup "awww-daemon"
spawn-at-startup "mi-power"
spawn-at-startup "quickshell" "-c" "mi-shell"
EOF

  echo "1. A modular config has been created at: $MI_KDL"
  echo "   Add this line to your ~/.config/niri/config.kdl to activate it:"
  echo ""
  echo "   include \"mi-shell.kdl\""
  echo ""

  # The rest of your info
  echo "2. Configuration & Customization:"
  echo "   - Local tweaks:   ~/.config/quickshell/mi-shell/"
  echo "   - System defaults: /etc/xdg/quickshell/mi-shell/"
}
