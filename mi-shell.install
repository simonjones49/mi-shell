post_install() {
  echo ":: MI-SHELL INSTALLED SUCCESSFULLY ::"
  echo ""
  echo "   To complete the setup for your user environment, please run"
  echo "   the following command in your terminal (do NOT use sudo):"
  echo ""
  echo "       mi-shell-setup"
  echo ""
  echo ":: SYSTEM SERVICES ::"
  echo "   - Ensuring NetworkManager is active for the internet applet..."

  # Since this hook runs as root, you can safely enable the system service directly!
  if ! systemctl is-active --quiet NetworkManager; then
    systemctl enable --now NetworkManager
  fi
  echo ""
}

post_upgrade() {
  post_install
}
