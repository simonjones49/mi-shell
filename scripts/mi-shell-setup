#!/bin/bash
set -e

# --- VARIABLE DEFINITIONS ---
# Define directories
NIRI_DIR="$HOME/.config/niri"
WALLPAPER_DIR="$HOME/Pictures/Wallpapers"
MI_USER_DIR="$HOME/.config/quickshell/mi-shell"

# Define target file paths
NIRI_CONFIG="$NIRI_DIR/config.kdl"
MISHELL_KDL_TARGET="$NIRI_DIR/mi-shell.kdl"
WALLPAPER_CONF="$MI_USER_DIR/wallpaper.conf"

# --- SYSTEM / ASSET DETECTION ---
MISHELL_KDL_TEMPLATE="/usr/share/mi-shell/mi-shell.kdl.example"

# Dynamically find where this script is running (your Git repo root)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Smart Path Routing: Use /usr/share if it exists (production), otherwise fallback to Git root (testing)
if [ -d "/usr/share/mi-shell" ]; then
    MI_SHELL_ROOT="/usr/share/mi-shell"
else
    MI_SHELL_ROOT="$SCRIPT_DIR"
fi

# Looking directly in the root folder now
DEFAULT_WALLPAPER_SRC="$MI_SHELL_ROOT/mi-wall.png"

# Define injection pattern string
INCLUDE_STR='include "mi-shell.kdl"'
PATTERN="^[[:space:]]*include[[:space:]]+['\"]mi-shell\.kdl['\"]"

echo "=== Starting mi-shell user environment configuration ==="

# --- STEP 1: Ensure a baseline Niri configuration exists FIRST ---
if [ ! -f "$NIRI_CONFIG" ]; then
    echo "Info: No existing Niri configuration found at $NIRI_CONFIG"

    if [ -f "/usr/share/doc/niri/default-config.kdl" ]; then
        echo "[Config] Seeding official system Niri defaults..."
        mkdir -p "$NIRI_DIR"
        cp /usr/share/doc/niri/default-config.kdl "$NIRI_CONFIG"
    else
        echo "Error: Could not locate a default Niri template on your system."
        exit 1
    fi
fi

# --- STEP 2: Copy mi-shell.kdl and initialize user wallpaper space ---
if [ -f "$MISHELL_KDL_TEMPLATE" ]; then
    echo "[Config] Placing mi-shell.kdl layout rules into $NIRI_DIR..."
    mkdir -p "$NIRI_DIR"
    cp "$MISHELL_KDL_TEMPLATE" "$MISHELL_KDL_TARGET"
else
    echo "Warning: System template not found at $MISHELL_KDL_TEMPLATE."
    echo "    Skipping mi-shell.kdl file copy. You may need to copy it manually."
fi

echo "[Storage] Setting up user assets and configuration directories..."
mkdir -p "$WALLPAPER_DIR"
mkdir -p "$MI_USER_DIR"

# Safely check if the user's wallpaper directory is completely empty
shopt -s nullglob
files=("$WALLPAPER_DIR"/*)
shopt -u nullglob # Turn off nullglob to restore standard shell behavior

if [ ${#files[@]} -eq 0 ]; then
    if [ -f "$DEFAULT_WALLPAPER_SRC" ]; then
        echo "[Wallpaper] First-time setup: Seeding default wallpaper to $WALLPAPER_DIR..."
        cp "$DEFAULT_WALLPAPER_SRC" "$WALLPAPER_DIR/mi-wall.png"
        chmod 644 "$WALLPAPER_DIR/mi-wall.png" # Ensure standard user read/write permissions

        echo "[Wallpaper] Creating local wallpaper.conf pointing to your new file..."
        echo "$WALLPAPER_DIR/mi-wall.png" > "$WALLPAPER_CONF"
    else
        echo "Warning: System wallpaper asset not found at $DEFAULT_WALLPAPER_SRC"
    fi
else
    echo "[Wallpaper] Wallpapers directory already has files. Leaving your custom layout alone."

    # If they have files but somehow don't have a config, point to their first image
    if [ ! -f "$WALLPAPER_CONF" ]; then
        echo "[Wallpaper] Initializing missing wallpaper.conf with your first existing image..."
        echo "${files[0]}" > "$WALLPAPER_CONF"
    fi
fi

# --- STEP 3: Now that config.kdl definitely exists, safely append the include ---
if grep -E -q "$PATTERN" "$NIRI_CONFIG"; then
    echo "[Niri] mi-shell inclusion is already present in your Niri configuration."
else
    echo "[Niri] Injecting mi-shell inclusion into Niri config..."
    # Always append using standard canonical formatting (with valid KDL '//' comments)
    echo -e "\n// Added by mi-shell package setup\n$INCLUDE_STR" >> "$NIRI_CONFIG"
    echo "[Niri] Success: mi-shell is now hooked into Niri."
fi

# --- STEP 4: List optional dependencies from PKGBUILD ---
echo ""

# Locate the PKGBUILD (assuming it's in the same directory as the script or project root)
PKGBUILD_PATH="$SCRIPT_DIR/PKGBUILD"

if [ -f "$PKGBUILD_PATH" ]; then
    echo "=== Optional Dependencies ==="
    echo "The following optional components can be installed to complete your system layout:"
    echo ""

    # Execute PKGBUILD in a safe subshell sandbox to read the optdepends array cleanly
    OPT_DEPS_RAW=$(bash -c "source '$PKGBUILD_PATH' && printf '%s\n' \"\${optdepends[@]}\"")

    # Print each dependency exactly as formatted in the PKGBUILD
    while IFS= read -r dep; do
        if [ -n "$dep" ]; then
            echo "    * $dep"
        fi
    done <<< "$OPT_DEPS_RAW"
    echo ""
fi

# --- STEP 5: Launch Guidance ---
echo "=== Quick Start Tip ==="
echo "To launch your new desktop environment correctly with all system services,"
echo "make sure to start your compositor using: niri-session"
echo ""

echo "=== Setup complete! ==="
