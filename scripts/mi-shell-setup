#!/bin/bash
set -e

# Define paths
NIRI_CONFIG="$HOME/.config/niri/config.kdl"
INCLUDE_STR='include "mi-shell.kdl"'
PATTERN="^[[:space:]]*include[[:space:]]+['\"]mi-shell\.kdl['\"]"

echo "🚀 Starting mi-shell user environment configuration..."

# --- STEP 1: Ensure a baseline Niri configuration exists FIRST ---
if [ ! -f "$NIRI_CONFIG" ]; then
    echo "ℹ️ No existing Niri configuration found at $NIRI_CONFIG"

    if [ -f "/usr/share/doc/niri/config.kdl" ]; then
        echo "📋 Seeding official system Niri defaults to prevent a blank desktop..."
        # Create directory just in case
        mkdir -p "$(dirname "$NIRI_CONFIG")"
        # Copy the safe, system-default template FIRST
        cp /usr/share/doc/niri/config.kdl "$NIRI_CONFIG"
    else
        echo "❌ Error: Could not locate a default Niri template on your system."
        echo "   To complete the installation safely without missing system defaults:"
        echo "   1. Launch Niri once to generate your baseline user configuration."
        echo "   2. Run 'mi-shell-setup' again."
        exit 1
    fi
fi

# --- STEP 2: Now that config.kdl definitely exists, safely append the include ---
if grep -E -q "$PATTERN" "$NIRI_CONFIG"; then
    echo "✔️ mi-shell inclusion is already present in your Niri configuration (or handled manually)."
else
    echo "⚡ Injecting mi-shell inclusion into Niri config..."
    # Always append using standard canonical formatting
    echo -e "\n# Added by mi-shell package setup\n$INCLUDE_STR" >> "$NIRI_CONFIG"
    echo "✅ Done! mi-shell is now hooked into Niri."
fi

echo "🎉 Setup complete!"
