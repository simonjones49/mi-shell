#!/bin/bash

# 1. Check for your personal setup first (aerc in kitty)
if command -v aerc &> /dev/null && command -v kitty &> /dev/null; then
    kitty --config "$HOME/.config/kitty/calendar.conf" --class mi-email -T Aerc -e aerc &
    exit 0
fi

# 2. Fallback to standard GUI clients if aerc isn't there
for client in thunderbird geary evolution; do
    if command -v "$client" &> /dev/null; then
        "$client" &
        exit 0
    fi
done

# 3. Ultimate fallback: Notify the user if no email client is found
if command -v notify-send &> /dev/null; then
    notify-send "mi-shell" "No supported email client found. Please install aerc, thunderbird, or geary."
fi
